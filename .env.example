# Copy to .env and fill in. A classic personal access token with the
# `public_repo` scope is enough; no other scopes are needed.
#
# Without this the contribution calendar (GraphQL) is unavailable, which means
# no commit events -- the organism will have repos and releases but no growth.
GITHUB_TOKEN=

# Optional. When set, `/` redirects to `/<this login>` instead of showing the
# placeholder line, so sharing the bare host URL lands on that garden.
GITDNA_DEFAULT_USER=
